    Size = UDim2.new(0, 280, 0, 278)
}):Play()

local Dragging = false
local DragStart = nil
local DragStartPos = nil

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        Dragging = true
        DragStart = input.Position
        DragStartPos = MainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - DragStart
        MainFrame.Position = UDim2.new(DragStartPos.X.Scale, DragStartPos.X.Offset + delta.X, DragStartPos.Y.Scale, DragStartPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        Dragging = false
    end
end)

ExecuteBtn.MouseButton1Click:Connect(function()
    if not SelectedGameData then
        StarterGui:SetCore("SendNotification", {
            Title = "YANTO HUB",
            Text = "Game tidak terdaftar!",
            Duration = 2
        })
        return
    end

    if SelectedGameId ~= CurrentPlaceId then
        StarterGui:SetCore("SendNotification", {
            Title = "YANTO HUB",
            Text = "SCRIPT TIDAK COCOK DENGAN MAP SAAT INI!",
            Duration = 3
        })
        return
    end

    if SelectedGameData.Script then
        TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0)
        }):Play()
        task.wait(0.3)

        ScreenGui:Destroy()

        local success, err = pcall(function()
            loadstring(game:HttpGet(SelectedGameData.Script))()
        end)

        if success then
            StarterGui:SetCore("SendNotification", {
                Title = "YANTO HUB",
                Text = "Script berhasil di execute!",
                Duration = 2
            })
        else
            StarterGui:SetCore("SendNotification", {
                Title = "YANTO HUB",
                Text = "Gagal execute script!",
                Duration = 2
            })
        end
    end
end)

if CurrentGameData then
    for _, child in pairs(ScriptList:GetChildren()) do
