local function CreateScriptButton(gameId, gameName, scriptUrl)
    local Button = Instance.new("TextButton")
    Button.Parent = ScriptList
    Button.Size = UDim2.new(1, -6, 0, 22)
    Button.BackgroundColor3 = Color3.fromRGB(30, 0, 0)
    Button.BackgroundTransparency = 0.4
    Button.Text = gameName
    Button.TextColor3 = Color3.fromRGB(200, 180, 180)
    Button.TextScaled = true
    Button.Font = Enum.Font.Gotham
    Button.BorderSizePixel = 0
    Button.AutoButtonColor = false

    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.Parent = Button
    ButtonCorner.CornerRadius = UDim.new(0, 3)

    local isSelected = (gameId == CurrentPlaceId)
    local SelectedIndicator = Instance.new("Frame")
    SelectedIndicator.Parent = Button
    SelectedIndicator.Size = UDim2.new(0, 2, 1, -3)
    SelectedIndicator.Position = UDim2.new(0, 3, 0, 1.5)
    SelectedIndicator.BackgroundColor3 = isSelected and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(150, 0, 0)
    SelectedIndicator.BackgroundTransparency = isSelected and 0 or 0.6
    SelectedIndicator.BorderSizePixel = 0

    local IndicatorCorner = Instance.new("UICorner")
    IndicatorCorner.Parent = SelectedIndicator
    IndicatorCorner.CornerRadius = UDim.new(0, 2)

    Button.MouseEnter:Connect(function()
        TweenService:Create(Button, TweenInfo.new(0.2), {BackgroundTransparency = 0.2}):Play()
    end)

    Button.MouseLeave:Connect(function()
        TweenService:Create(Button, TweenInfo.new(0.2), {BackgroundTransparency = 0.4}):Play()
    end)

    Button.MouseButton1Click:Connect(function()
        if gameId ~= CurrentPlaceId then
            StarterGui:SetCore("SendNotification", {
                Title = "YANTO HUB",
                Text = "SCRIPT TIDAK COCOK! ID: " .. gameId .. " | MAP: " .. CurrentPlaceId,
                Duration = 4
            })
            return
        end

        for _, child in pairs(ScriptList:GetChildren()) do
            if child:IsA("TextButton") then
                local indicator = child:FindFirstChildWhichIsA("Frame")
                if indicator then
                    indicator.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
                    indicator.BackgroundTransparency = 0.6
                end
            end
        end

        SelectedIndicator.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        SelectedIndicator.BackgroundTransparency = 0

        SelectedGameData = Games[gameId]
        SelectedGameId = gameId

        if SelectedGameData then
            GameNameDisplay.Text = SelectedGameData.Name
            GameNameDisplay.TextColor3 = Color3.fromRGB(255, 100, 100)
            StatusFrame.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
            StatusLabel.Text = "SUPPORTED"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            ExecuteBtn.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
            ExecuteBtn.Text = "EXECUTE"
            ExecuteBtn.Active = true
        end
    end)

    return Button
end

for gameId, data in pairs(Games) do
